{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
      "chromium": {
        "type": "local",
        "command": ["./target/debug/chromium-mcp"],
        "enabled": true,
        "environment": { "CHROME_PATH": "/usr/bin/chromium", "CHROME_FLAGS": "--enable-features=WebMCPTesting" }
      }
    }
  }